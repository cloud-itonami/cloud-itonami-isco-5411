;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a station-logistics robot handles apparatus /
;; gear readiness and equipment / supply coordination at the fire station
;; -- and never makes a structure-entry, triage, treatment or tactical
;; decision. Declared here only station readiness work: SCBA cylinders
;; lifted into the charging rack, the cylinder cart run from the apparatus
;; bay to the compressor room, and refilling the engine's water tank at the
;; station after it returns.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-5411"
 :cases
 [{:id :scba-cylinder-to-rack
   :kind :manipulator
   :procedure "arm lifts an SCBA cylinder from the cart into the compressor room's charging rack"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 5.0 :m2-kg 3.5
            :from [0.55 0.00] :to [0.45 0.55] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [3.0 5.0 7.0 9.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 90.0 :basis "estimate: continuous shoulder torque of a ~10 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 30.0}}
  {:id :cylinder-cart-bay-to-compressor
   :kind :transport
   :procedure "robot moves the cart of used SCBA cylinders from the apparatus bay to the compressor room"
   :params {:mass-kg 60.0 :distance-m 40.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 120.0 :crr 0.015
            :cog-height-m 0.70 :support-half-length-m 0.30}
   :sweep {:param :payload-kg :values [20.0 50.0 90.0 140.0 200.0]}
   :quantity :cycle-time-s
   :limit {:max 50.0 :basis "estimate: one bay-to-compressor leg inside the post-incident readiness turnaround"}
   :boundary {:lo 5.0 :hi 800.0}}
  {:id :engine-tank-refill-line
   :kind :pipe-flow
   :procedure "engine water tank refilled at the station through a 65 mm supply hose, 30 m from the station hydrant"
   :params {:diameter-m 0.065 :length-m 30.0 :roughness-m 1.5e-4
            :density-kg-m3 998.0 :viscosity-pa-s 1.0e-3 :pump-efficiency 0.65 :elevation-m 1.5}
   :sweep {:param :q-m3s :values [0.005 0.010 0.015 0.020 0.025 0.030]}
   :quantity :pressure-drop-pa
   :limit {:max 200000.0 :basis "estimate: pressure the station hydrant can spend in the supply line while keeping a residual; hose roughness is also an estimate"}
   :boundary {:lo 0.002 :hi 0.06}}]}
